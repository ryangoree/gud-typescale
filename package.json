{
  "name": "@gud/design-system",
  "version": "2.0.2",
  "description": "A utility for generating design systems.",
  "license": "MIT",
  "author": "Ryan Goree (https://github.com/ryangoree)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangoree/gud-design-system.git"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "design": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/lib/index.d.mts",
        "default": "./dist/lib/index.mjs"
      },
      "require": {
        "types": "./dist/lib/index.d.cts",
        "default": "./dist/lib/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && biome check --diagnostic-level error . ",
    "check:package": "publint",
    "fix": "biome check --diagnostic-level error . --write",
    "fix:unsafe": "npm run fix --unsafe",
    "build": "tsc -p tsconfig.cli.json && tsdown",
    "build:watch": "tsdown --watch",
    "build:docs": "typedoc",
    "preview:docs": "serve ./docs",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@gud/cli": "^1.0.0-beta.7",
    "@gud/cli-menu": "^1.0.0-beta.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.6.0",
    "publint": "^0.3.18",
    "tsdown": "^0.21.9",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "imports": {
    "#src/*": {
      "import": "./dist/*.mjs",
      "require": "./dist/*.cjs"
    }
  },
  "main": "dist/lib/index.cjs",
  "module": "dist/lib/index.mjs",
  "types": "dist/lib/index.d.mts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
